#!/bin/sh
# Persistent startup for sys-split (Qubes runs /rw/config/rc.local as root at boot).
# Starts Tor + WireGuard and installs the UDP policy route. Safe to re-run.

# No IPv6 anywhere on this proxy.
sysctl -w net.ipv6.conf.all.disable_ipv6=1 net.ipv6.conf.default.disable_ipv6=1 >/dev/null 2>&1

# Tor (transparent TCP + DNS), as debian-tor so the firewall can key on its UID.
install -d -o debian-tor -g debian-tor /var/lib/tor
pkill -u debian-tor tor 2>/dev/null
sudo -u debian-tor tor -f /rw/config/torrc --runasdaemon 1

# ProtonVPN WireGuard (Table=off in wg0.conf => no catch-all route).
wg show wg0 >/dev/null 2>&1 || wg-quick up /rw/config/wg0.conf

# Policy routing: marked (agent) UDP leaves via the tunnel; blackhole if wg0 is down.
ip rule add fwmark 0x2 table 200 2>/dev/null || true
ip route replace default dev wg0 table 200 2>/dev/null || true
ip route add blackhole default metric 1000 table 200 2>/dev/null || true
